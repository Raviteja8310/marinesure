# MarineSure 2.0 Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env to version control.

APP_NAME=MarineSure
APP_ENV=development
DEBUG=true

# Database
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=marinesure
MYSQL_USER=marinesure_app
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root

# JWT Authentication
JWT_SECRET_KEY=change_me_to_a_random_64_char_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Provider (gemini or openai)
AI_PROVIDER=gemini
AI_API_KEY=change_me

# Razorpay (Test Mode)
RAZORPAY_KEY_ID=change_me
RAZORPAY_KEY_SECRET=change_me

# SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=change_me
SMTP_PASSWORD=change_me
SMTP_FROM_EMAIL=noreply@marinesure.local

# Redis
REDIS_URL=redis://redis:6379/0

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
